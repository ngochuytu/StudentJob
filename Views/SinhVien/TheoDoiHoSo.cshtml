@model List<StudentJob.Models.HoSoUngTuyen>

@{
    ViewData["Title"] = "Theo dõi hồ sơ";

    int tongHoSo = Model.Count;
    int choDuyet = Model.Count(h => h.sTrangThaiXetDuyet == "Chờ duyệt");
    int henPhongVan = Model.Count(h => h.sTrangThaiXetDuyet == "Hẹn phỏng vấn");
    int tuChoi = Model.Count(h => h.sTrangThaiXetDuyet == "Từ chối");
}

<section class="student-application-page py-5">
    <div class="container">
        <div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-center gap-3 mb-4">
            <div>
                <span class="text-primary fw-semibold text-uppercase small">
                    Hồ sơ sinh viên
                </span>

                <h1 class="h2 fw-bold mb-2">
                    Theo dõi trạng thái hồ sơ
                </h1>

                <p class="text-secondary mb-0">
                    Theo dõi tiến trình xét duyệt các công việc bạn đã ứng tuyển.
                </p>
            </div>
        </div>

        <div class="row g-4 mb-5">
            <div class="col-12 col-sm-6 col-xl-3">
                <div class="card border-0 shadow-sm student-stat-card h-100">
                    <div class="card-body p-4">
                        <div class="d-flex justify-content-between align-items-start">
                            <div>
                                <p class="text-secondary mb-2">Tổng hồ sơ</p>
                                <h2 class="display-6 fw-bold mb-0">
                                    @tongHoSo
                                </h2>
                            </div>

                           
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-12 col-sm-6 col-xl-3">
                <div class="card border-0 shadow-sm student-stat-card h-100">
                    <div class="card-body p-4">
                        <div class="d-flex justify-content-between align-items-start">
                            <div>
                                <p class="text-secondary mb-2">Chờ duyệt</p>
                                <h2 class="display-6 fw-bold mb-0">
                                    @choDuyet
                                </h2>
                            </div>
                                                    </div>
                    </div>
                </div>
            </div>

            <div class="col-12 col-sm-6 col-xl-3">
                <div class="card border-0 shadow-sm student-stat-card h-100">
                    <div class="card-body p-4">
                        <div class="d-flex justify-content-between align-items-start">
                            <div>
                                <p class="text-secondary mb-2">Hẹn phỏng vấn</p>
                                <h2 class="display-6 fw-bold mb-0">
                                    @henPhongVan
                                </h2>
                            </div>
                                                    </div>
                    </div>
                </div>
            </div>

            <div class="col-12 col-sm-6 col-xl-3">
                <div class="card border-0 shadow-sm student-stat-card h-100">
                    <div class="card-body p-4">
                        <div class="d-flex justify-content-between align-items-start">
                            <div>
                                <p class="text-secondary mb-2">Từ chối</p>
                                <h2 class="display-6 fw-bold mb-0">
                                    @tuChoi
                                </h2>
                            </div>

                            
                        </div>
                    </div>
                </div>
            </div>
        </div>

        @if (Model.Count == 0)
        {
            <div class="card border-0 shadow-sm">
                <div class="card-body text-center py-5 px-3">
                    

                    <h2 class="h5 fw-bold">
                        Bạn chưa nộp hồ sơ nào
                    </h2>

                    <p class="text-secondary mb-0">
                        Hãy tìm công việc phù hợp và nộp CV để bắt đầu theo dõi tiến trình ứng tuyển.
                    </p>
                </div>
            </div>
        }
        else
        {
            <div class="row g-4">
                @foreach (var hoSo in Model)
                {
                    string badgeClass = hoSo.sTrangThaiXetDuyet switch
                    {
                        "Hẹn phỏng vấn" => "text-bg-success",
                        "Từ chối" => "text-bg-danger",
                        _ => "text-bg-warning"
                    };

                    string iconClass = hoSo.sTrangThaiXetDuyet switch
                    {
                        "Hẹn phỏng vấn" => "bi-calendar-check",
                        "Từ chối" => "bi-x-circle",
                        _ => "bi-clock-history"
                    };

                    <div class="col-12">
                        <article class="card border-0 shadow-sm application-history-card">
                            <div class="card-body p-4">
                                <div class="row g-4 align-items-start">
                                    <div class="col-12 col-lg">
                                        <div class="d-flex flex-column flex-md-row gap-4">
                                            <div class="application-company-logo flex-shrink-0">
                                                @if (!string.IsNullOrWhiteSpace(
                                                    hoSo.BaiTuyenDung.NhaTuyenDung.sDuongDanAnhLogo))
                                                {
                                                    <img src="@hoSo.BaiTuyenDung.NhaTuyenDung.sDuongDanAnhLogo"
                                                         alt="@hoSo.BaiTuyenDung.NhaTuyenDung.sTenDoanhNghiep"
                                                         onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';" />

                                                    
                                                }
                                                else
                                                {
                                                    
                                                }
                                            </div>

                                            <div class="flex-grow-1">
                                                <div class="d-flex flex-wrap align-items-center gap-2 mb-2">
                                                    <span class="badge rounded-pill @badgeClass">
                                                        @hoSo.sTrangThaiXetDuyet
                                                    </span>

                                                    <span class="text-secondary small">
                                                        Nộp lúc
                                                        @hoSo.dThoiGianNopHoSo.ToString("dd/MM/yyyy HH:mm")
                                                    </span>
                                                </div>

                                                <h2 class="h5 fw-bold mb-2">
                                                    @hoSo.BaiTuyenDung.sTieuDeCongViec
                                                </h2>

                                                <p class="text-primary fw-semibold mb-3">
                                                    @hoSo.BaiTuyenDung.NhaTuyenDung.sTenDoanhNghiep
                                                </p>

                                                <div class="d-flex flex-wrap gap-3 text-secondary small">
                                                    <span>
                                                        @hoSo.BaiTuyenDung.sHinhThucLamViec
                                                    </span>

                                                    <span>
                                                        @hoSo.BaiTuyenDung.sMucLuong
                                                    </span>

                                                    <span>
                                                        Hạn nộp:
                                                        @hoSo.BaiTuyenDung.dHanNopHoSo.ToString("dd/MM/yyyy")
                                                    </span>
                                                </div>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="col-12 col-lg-auto">
                                        <div class="d-flex flex-column gap-2 application-action-group">
                                            <a asp-controller="ViecLam"
                                               asp-action="ChiTiet"
                                               asp-route-id="@hoSo.BaiTuyenDung.PK_IdBaiTuyenDung"
                                               class="btn btn-outline-primary">
                                                Xem công việc
                                            </a>

                                            <a href="@hoSo.sDuongDanCV"
                                               target="_blank"
                                               rel="noopener noreferrer"
                                               class="btn btn-light border">
                                                Xem CV đã nộp
                                            </a>
                                        </div>
                                    </div>
                                </div>

                                @if (!string.IsNullOrWhiteSpace(hoSo.sGhiChuPhanHoi))
                                {
                                    <div class="application-feedback mt-4">
                                        <div class="d-flex gap-3">
                                            

                                            <div>
                                                <span class="small fw-semibold text-primary d-block mb-1">
                                                    Phản hồi từ nhà tuyển dụng
                                                </span>

                                                <p class="mb-0 text-secondary">
                                                    @hoSo.sGhiChuPhanHoi
                                                </p>
                                            </div>
                                        </div>
                                    </div>
                                }
                                else
                                {
                                    <div class="application-feedback mt-4">
                                        <div class="d-flex gap-3">
                                            

                                            <div>
                                                <span class="small fw-semibold text-secondary d-block mb-1">
                                                    Chưa có phản hồi
                                                </span>

                                                <p class="mb-0 text-secondary small">
                                                    Nhà tuyển dụng chưa gửi ghi chú cho hồ sơ này.
                                                </p>
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        </article>
                    </div>
                }
            </div>
        }
    </div>
</section>