<div class="toast-container position-fixed bottom-0 end-0 p-3" style="z-index:999;">
    <div id="toastNotification" class="toast align-items-center text-white border-0 rounded-3 shadow" role="alert" aria-live="assertive" aria-atomic="true">
        <div class="d-flex">
            <div class="toast-body d-flex align-items-center gap-2 py-3">
                <span id="toastMessage" class="fw-semibold"></span>
            </div>
            <button type="button" class="btn-close btn-close-white m-auto me-2" data-bs-dismiss="toast" aria-label="Close"></button>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        async function toggleAccountStatus(accountId, makeActive, buttonElement) {
            if (buttonElement.disabled) return;
            buttonElement.disabled = true;

            const originalContent = buttonElement.innerHTML;
            buttonElement.innerHTML = `<span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>`;

            try {
                const params = new URLSearchParams();
                params.append('id', accountId);
                params.append('active', makeActive);

                const response = await fetch('/admin/khoa-tai-khoan', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/x-www-form-urlencoded'
                    },
                    body: params
                });

                if (!response.ok) {
                    throw new Error('Lỗi máy chủ: ' + response.statusText);
                }

                const result = await response.json();

                if (result.success) {
                    const row = buttonElement.closest('tr');
                    
                    const newStatusLabel = makeActive ? "Hoạt động" : "Bị khóa";
                    row.setAttribute('data-status', newStatusLabel);

                    const badge = row.querySelector('.status-badge');
                    if (makeActive) {
                        badge.className = 'status-badge badge text-success border border-success px-3 py-1.5 rounded-pill fw-semibold';
                        badge.textContent = 'Hoạt động';

                        buttonElement.className = 'btn btn-sm rounded-pill px-3 py-1.5 fw-bold btn-outline-danger';
                        buttonElement.innerHTML = `<span class="btn-text">Khóa</span>`;
                        buttonElement.setAttribute('onclick', `toggleAccountStatus(${accountId}, false, this)`);
                    } else {
                        badge.className = 'status-badge badge bg-danger-subtle text-danger border border-danger px-3 py-1.5 rounded-pill fw-semibold';
                        badge.textContent = 'Bị khóa';

                        buttonElement.className = 'btn btn-sm rounded-pill px-3 py-1.5 fw-bold btn-outline-success';
                        buttonElement.innerHTML = `<span class="btn-text">Mở khóa</span>`;
                        buttonElement.setAttribute('onclick', `toggleAccountStatus(${accountId}, true, this)`);
                    }

                    showToast(result.message, 'success');
                } else {
                    showToast(result.message || 'Cập nhật trạng thái thất bại.', 'danger');
                    buttonElement.innerHTML = originalContent;
                }
            } catch (error) {
                console.error('Error toggling account status:', error);
                showToast('Không thể kết nối đến hệ thống. Vui lòng thử lại.', 'danger');
                buttonElement.innerHTML = originalContent;
            } finally {
                buttonElement.disabled = false;
            }
        }

        function showToast(message, type) {
            const toastEl = document.getElementById('toastNotification');
            const toastMessage = document.getElementById('toastMessage');

            toastMessage.textContent = message;

            if (type === 'success') {
                toastEl.className = 'toast align-items-center text-white bg-success border-0 rounded-3 shadow';
            } else {
                toastEl.className = 'toast align-items-center text-white bg-danger border-0 rounded-3 shadow';
            }

            const toast = new bootstrap.Toast(toastEl, { delay: 4000 });
            toast.show();
        }

