<div class="row g-4 mb-5">
    <div class="col-12 col-sm-6 col-lg-3">
        <div class="card border border rounded-3 h-100">
            <div class="card-body p-4">
                <span class="text-primary small fw-bold text-uppercase d-block mb-1">Tổng bài đăng</span>
                <h3 class="fw-extrabold text-dark mb-0" id="statTotalJobs">@ViewBag.TotalJobs</h3>
            </div>
        </div>
    </div>

    <div class="col-12 col-sm-6 col-lg-3">
        <div class="card border border rounded-3 h-100">
            <div class="card-body p-4">
                <span class="text-success small fw-bold text-uppercase d-block mb-1">Đã duyệt</span>
                <h3 class="fw-extrabold text-success mb-0" id="statApprovedJobs">@ViewBag.ApprovedJobs</h3>
            </div>
        </div>
    </div>

    <div class="col-12 col-sm-6 col-lg-3">
        <div class="card border border rounded-3 h-100">
            <div class="card-body p-4">
                <span class="text-warning small fw-bold text-uppercase d-block mb-1">Chờ duyệt</span>
                <h3 class="fw-extrabold text-warning mb-0" id="statPendingJobs">@ViewBag.PendingJobs</h3>
            </div>
        </div>
    </div>

    <div class="col-12 col-sm-6 col-lg-3">
        <div class="card border border rounded-3 h-100">
            <div class="card-body p-4">
                <span class="text-danger small fw-bold text-uppercase d-block mb-1">Từ chối</span>
                <h3 class="fw-extrabold text-danger mb-0" id="statRejectedJobs">@ViewBag.RejectedJobs</h3>
            </div>
        </div>
    </div>
</div>
