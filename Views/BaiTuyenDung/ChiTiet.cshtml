@model StudentJob.Models.ChiTietBaiTuyenDungViewModel

@{
    ViewData["Title"] = Model.BaiTuyenDung.sTieuDeCongViec;

    var baiTuyenDung = Model.BaiTuyenDung;
    var nhaTuyenDung = baiTuyenDung.NhaTuyenDung;

    string logoUrl = string.IsNullOrWhiteSpace(nhaTuyenDung.sDuongDanAnhLogo)
        ? "/images/company-placeholder.png"
        : nhaTuyenDung.sDuongDanAnhLogo;
}

<section class="job-detail-hero py-5">
    <div class="container">
        <div class="job-detail-hero-card">
            <div class="row align-items-center g-4">
                <div class="col-12 col-lg">
                    <div class="d-flex flex-column flex-md-row align-items-md-center gap-4">
                        <div class="company-logo-wrapper flex-shrink-0">
                            <img src="@logoUrl"
                                 alt="@nhaTuyenDung.sTenDoanhNghiep"
                                 class="company-logo"
                                 onerror="this.src='/images/company-placeholder.png'" />
                        </div>

                        <div>
                            <div class="d-flex flex-wrap gap-2 mb-3">
                                <span class="badge rounded-pill bg-primary-subtle text-primary px-3 py-2">
                                    @baiTuyenDung.sHinhThucLamViec
                                </span>

                                <span class="badge rounded-pill bg-success-subtle text-success px-3 py-2">
                                    Đã duyệt
                                </span>
                            </div>

                            <h1 class="display-6 fw-bold mb-3">
                                @baiTuyenDung.sTieuDeCongViec
                            </h1>

                            <p class="fs-5 fw-semibold text-primary mb-3">
                                @nhaTuyenDung.sTenDoanhNghiep
                            </p>

                            <div class="d-flex flex-wrap gap-3 text-secondary">
                                <span>
                                    <i class="bi bi-geo-alt me-1"></i>
                                    @baiTuyenDung.KhuVuc.sTenKhuVuc
                                </span>

                                <span>
                                    <i class="bi bi-briefcase me-1"></i>
                                    @baiTuyenDung.NganhNghe.sTenLinhVuc
                                </span>

                                <span>
                                    <i class="bi bi-calendar-event me-1"></i>
                                    Hạn nộp:
                                    @baiTuyenDung.dHanNopHoSo.ToString("dd/MM/yyyy")
                                </span>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-12 col-lg-auto">
                    <div class="job-salary-box">
                        <span class="text-secondary small d-block mb-1">
                            Mức lương
                        </span>

                        <strong class="fs-5 text-dark">
                            @baiTuyenDung.sMucLuong
                        </strong>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="job-detail-content pb-5">
    <div class="container">
        <div class="row g-4 g-xl-5">
            <div class="col-12 col-lg-8">
                <article class="card border-0 shadow-sm job-content-card mb-4">
                    <div class="card-body p-4 p-lg-5">
                        <h2 class="h4 fw-bold mb-4">
                            Mô tả công việc
                        </h2>

                        <div class="job-description text-secondary">
                            @foreach (string paragraph in
                                baiTuyenDung.sMoTaCongViec.Split(
                                    '\n',
                                    StringSplitOptions.RemoveEmptyEntries))
                            {
                                <p>@paragraph</p>
                            }
                        </div>
                    </div>
                </article>

                <article class="card border-0 shadow-sm job-content-card mb-4">
                    <div class="card-body p-4 p-lg-5">
                        <h2 class="h4 fw-bold mb-4">
                            Thông tin công việc
                        </h2>

                        <div class="row g-4">
                            <div class="col-12 col-md-6">
                                <div class="job-info-item">
                                    <div class="job-info-icon">
                                        <i class="bi bi-clock"></i>
                                    </div>

                                    <div>
                                        <span class="text-secondary small d-block mb-1">
                                            Ca làm
                                        </span>

                                        <strong>
                                            @(string.IsNullOrWhiteSpace(baiTuyenDung.sCaLam)
                                                ? "Trao đổi khi phỏng vấn"
                                                : baiTuyenDung.sCaLam)
                                        </strong>
                                    </div>
                                </div>
                            </div>

                            <div class="col-12 col-md-6">
                                <div class="job-info-item">
                                    <div class="job-info-icon">
                                        <i class="bi bi-wallet2"></i>
                                    </div>

                                    <div>
                                        <span class="text-secondary small d-block mb-1">
                                            Mức lương
                                        </span>

                                        <strong>
                                            @baiTuyenDung.sMucLuong
                                        </strong>
                                    </div>
                                </div>
                            </div>

                            <div class="col-12 col-md-6">
                                <div class="job-info-item">
                                    <div class="job-info-icon">
                                        <i class="bi bi-briefcase"></i>
                                    </div>

                                    <div>
                                        <span class="text-secondary small d-block mb-1">
                                            Hình thức làm việc
                                        </span>

                                        <strong>
                                            @baiTuyenDung.sHinhThucLamViec
                                        </strong>
                                    </div>
                                </div>
                            </div>

                            <div class="col-12 col-md-6">
                                <div class="job-info-item">
                                    <div class="job-info-icon">
                                        <i class="bi bi-calendar-check"></i>
                                    </div>

                                    <div>
                                        <span class="text-secondary small d-block mb-1">
                                            Hạn nộp hồ sơ
                                        </span>

                                        <strong class="@(Model.DaHetHan ? "text-danger" : "")">
                                            @baiTuyenDung.dHanNopHoSo.ToString("dd/MM/yyyy")
                                        </strong>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </article>

                <article class="card border-0 shadow-sm job-content-card">
                    <div class="card-body p-4 p-lg-5">
                        <div class="d-flex flex-column flex-sm-row align-items-sm-start gap-4">
                            <div class="company-logo-wrapper flex-shrink-0">
                                <img src="@logoUrl"
                                     alt="@nhaTuyenDung.sTenDoanhNghiep"
                                     class="company-logo"
                                     onerror="this.src='/images/company-placeholder.png'" />
                            </div>

                            <div>
                                <span class="text-primary fw-semibold small text-uppercase">
                                    Về doanh nghiệp
                                </span>

                                <h2 class="h4 fw-bold mt-2 mb-3">
                                    @nhaTuyenDung.sTenDoanhNghiep
                                </h2>

                                <p class="text-secondary mb-3">
                                    @(string.IsNullOrWhiteSpace(nhaTuyenDung.sMoTaTongQuan)
                                        ? "Doanh nghiệp chưa cập nhật phần giới thiệu."
                                        : nhaTuyenDung.sMoTaTongQuan)
                                </p>

                                <p class="mb-0">
                                    <i class="bi bi-geo-alt text-primary me-2"></i>
                                    @nhaTuyenDung.sDiaChiVanPhong
                                </p>
                            </div>
                        </div>
                    </div>
                </article>
            </div>

            <div class="col-12 col-lg-4">
                <aside class="card border-0 shadow-sm job-apply-card sticky-lg-top">
                    <div class="card-body p-4">
                        <h2 class="h5 fw-bold mb-2">
                            Ứng tuyển công việc này
                        </h2>

                        <p class="text-secondary small mb-4">
                            Nộp CV và thư xin việc trực tiếp đến nhà tuyển dụng.
                        </p>

                        @if (Model.DaDangNhap && Model.LaSinhVien)
                        {
                            @Html.AntiForgeryToken()

                            <button type="button"
                                    id="saveJobButton"
                                    class="btn @(Model.DaLuuTin ? "btn-primary" : "btn-outline-primary") w-100 mb-3"
                                    data-job-id="@baiTuyenDung.PK_IdBaiTuyenDung"
                                    data-is-saved="@Model.DaLuuTin.ToString().ToLowerInvariant()">
                                <span class="save-job-text">
                                    @if (Model.DaLuuTin)
                                    {
                                        <i class="bi bi-bookmark-check-fill me-2"></i>
                                        <span>Đã lưu tin</span>
                                    }
                                    else
                                    {
                                        <i class="bi bi-bookmark me-2"></i>
                                        <span>Lưu tin</span>
                                    }
                                </span>

                                <span class="save-job-loading d-none">
                                    <span class="spinner-border spinner-border-sm me-2"
                                          aria-hidden="true">
                                    </span>
                                    Đang xử lý...
                                </span>
                            </button>

                            <div id="saveJobAlert"></div>
                        }

                        @if (Model.DaHetHan)
                        {
                            <div class="alert alert-danger border-0 mb-0">
                                <i class="bi bi-calendar-x me-2"></i>
                                Tin tuyển dụng đã hết hạn nhận hồ sơ.
                            </div>
                        }
                        else if (!Model.DaDangNhap)
                        {
                            <a asp-controller="TaiKhoan"
                               asp-action="DangNhap"
                               asp-route-returnUrl="@Context.Request.Path"
                               class="btn btn-primary w-100 py-3">
                                <i class="bi bi-box-arrow-in-right me-2"></i>
                                Đăng nhập để ứng tuyển
                            </a>
                        }
                        else if (!Model.LaSinhVien)
                        {
                            <div class="alert alert-warning border-0 mb-0">
                                <i class="bi bi-exclamation-circle me-2"></i>
                                Chỉ tài khoản Sinh viên mới có thể ứng tuyển.
                            </div>
                        }
                        else if (Model.DaUngTuyen)
                        {
                            <div class="alert alert-success border-0 mb-3">
                                <i class="bi bi-check-circle-fill me-2"></i>
                                Bạn đã ứng tuyển công việc này.
                            </div>

                            <a asp-controller="SinhVien"
                               asp-action="TheoDoiHoSo"
                               class="btn btn-outline-primary w-100">
                                Theo dõi hồ sơ
                            </a>
                        }
                        else
                        {
                            <button type="button"
                                    class="btn btn-primary w-100 py-3"
                                    data-bs-toggle="modal"
                                    data-bs-target="#applicationModal">
                                <i class="bi bi-send me-2"></i>
                                Ứng tuyển ngay
                            </button>
                        }

                        <hr class="my-4" />

                        <div class="small text-secondary">
                            <div class="d-flex gap-2 mb-3">
                                <i class="bi bi-shield-check text-primary"></i>
                                <span>
                                    Tin đã được StudentJob kiểm duyệt.
                                </span>
                            </div>

                            <div class="d-flex gap-2">
                                <i class="bi bi-file-earmark-lock text-primary"></i>
                                <span>
                                    CV chỉ được cung cấp cho nhà tuyển dụng liên quan.
                                </span>
                            </div>
                        </div>
                    </div>
                </aside>
            </div>
        </div>
    </div>
</section>

@if (Model.DaDangNhap &&
     Model.LaSinhVien &&
     !Model.DaUngTuyen &&
     !Model.DaHetHan)
{
    <div class="modal fade"
         id="applicationModal"
         tabindex="-1"
         aria-labelledby="applicationModalLabel"
         aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content border-0 shadow">
                <div class="modal-header border-0 px-4 px-lg-5 pt-4">
                    <div>
                        <span class="text-primary fw-semibold small text-uppercase">
                            Nộp hồ sơ
                        </span>

                        <h2 class="modal-title h4 fw-bold mt-1"
                            id="applicationModalLabel">
                            @baiTuyenDung.sTieuDeCongViec
                        </h2>
                    </div>

                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="modal"
                            aria-label="Đóng">
                    </button>
                </div>

                <div class="modal-body px-4 px-lg-5 py-4">
                    <div id="applicationAlert"></div>

                    <form id="applicationForm"
                          enctype="multipart/form-data">
                        @Html.AntiForgeryToken()

                        <input asp-for="UngTuyen.FK_IdBaiTuyenDung"
                               type="hidden" />

                        @if (Model.CoCVMacDinh)
                        {
                            <div class="application-cv-option mb-4">
                                <div class="form-check">
                                    <input asp-for="UngTuyen.SuDungCVMacDinh"
                                           class="form-check-input"
                                           type="checkbox"
                                           id="useDefaultCv" />

                                    <label class="form-check-label fw-semibold"
                                           for="useDefaultCv">
                                        Sử dụng CV mặc định trong hồ sơ
                                    </label>
                                </div>

                                <p class="text-secondary small mb-0 mt-2">
                                    Bỏ chọn nếu bạn muốn tải lên CV khác cho công việc này.
                                </p>
                            </div>
                        }

                        <div class="mb-4"
                             id="uploadCvGroup">
                            <label asp-for="UngTuyen.TepCV"
                                   class="form-label fw-semibold">
                                Tải CV lên
                            </label>

                            <input asp-for="UngTuyen.TepCV"
                                   class="form-control"
                                   type="file"
                                   accept=".pdf,.docx" />

                            <div class="form-text">
                                Chấp nhận PDF hoặc DOCX, tối đa 5 MB.
                            </div>
                        </div>

                        <div class="mb-0">
                            <label asp-for="UngTuyen.sThuXinViec"
                                   class="form-label fw-semibold">
                                Thư xin việc
                            </label>

                            <textarea asp-for="UngTuyen.sThuXinViec"
                                      class="form-control"
                                      rows="6"
                                      maxlength="3000"
                                      placeholder="Giới thiệu ngắn gọn về bản thân, kinh nghiệm và lý do bạn phù hợp với công việc..."></textarea>

                            <div class="form-text">
                                Tối đa 3000 ký tự.
                            </div>
                        </div>
                    </form>
                </div>

                <div class="modal-footer border-0 px-4 px-lg-5 pb-4">
                    <button type="button"
                            class="btn btn-light"
                            data-bs-dismiss="modal">
                        Hủy
                    </button>

                    <button type="button"
                            class="btn btn-primary px-4"
                            id="submitApplicationButton">
                        <span class="application-submit-text">
                            <i class="bi bi-send me-2"></i>
                            Nộp hồ sơ
                        </span>

                        <span class="application-submit-loading d-none">
                            <span class="spinner-border spinner-border-sm me-2"
                                  aria-hidden="true">
                            </span>
                            Đang gửi...
                        </span>
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@section Scripts {
    <script src="~/js/ung-tuyen.js"
            asp-append-version="true"></script>

    <script src="~/js/luu-tin.js"
            asp-append-version="true"></script>
}