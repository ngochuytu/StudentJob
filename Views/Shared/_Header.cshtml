@using System.Security.Claims

<header class="bg-white border-bottom sticky-top shadow-sm">
    <nav class="navbar navbar-expand-lg navbar-light py-3 container">
        <a class="navbar-brand d-flex align-items-center gap-2 fw-bold text-dark fs-4"
           asp-controller="Home"
           asp-action="Index">
            <partial name="_LogoSvg" />
            StudentJob
        </a>

        <button class="navbar-toggler border-0"
                type="button"
                data-bs-toggle="collapse"
                data-bs-target="#navbarMain"
                aria-controls="navbarMain"
                aria-expanded="false"
                aria-label="Mở menu">
            <span class="navbar-toggler-icon"></span>
        </button>

        <div class="collapse navbar-collapse" id="navbarMain">
            <ul class="navbar-nav mx-auto mb-2 mb-lg-0">
                @if (User.Identity?.IsAuthenticated == true)
                {
                    var role = User.FindFirst(ClaimTypes.Role)?.Value;

                    if (role == "Admin")
                    {
                        <li class="nav-item">
                            <a class="nav-link fw-medium text-dark px-3 py-2 rounded"
                               asp-controller="Admin"
                               asp-action="QuanLyTin">
                                Quản lý tin tuyển dụng
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link fw-medium text-dark px-3 py-2 rounded"
                               asp-controller="Admin"
                               asp-action="QuanLyTaiKhoan">
                                Quản lý tài khoản
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link fw-medium text-dark px-3 py-2 rounded"
                               asp-controller="Admin"
                               asp-action="ThongKe">
                                Thống kê
                            </a>
                        </li>
                    }
                    else if (role == "Sinh viên")
                    {
                        <li class="nav-item">
                            <a class="nav-link fw-medium text-dark px-3 py-2 rounded"
                               asp-controller="SinhVien"
                               asp-action="TheoDoiHoSo">
                                Theo dõi hồ sơ
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link fw-medium text-dark px-3 py-2 rounded"
                               asp-controller="SinhVien"
                               asp-action="TinDaLuu">
                                Tin đã lưu
                            </a>
                        </li>
                    }
                    else if (role == "Nhà tuyển dụng")
                    {
                        <li class="nav-item">
                            <a class="nav-link fw-medium text-dark px-3 py-2 rounded"
                               asp-controller="NhaTuyenDung"
                               asp-action="QuanLyTin">
                                Quản lý tin tuyển dụng
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link fw-medium text-dark px-3 py-2 rounded"
                               asp-controller="NhaTuyenDung"
                               asp-action="QuanLyHoSo">
                                Quản lý hồ sơ ứng tuyển
                            </a>
                        </li>
                    }
                }
            </ul>

            <div class="d-flex align-items-center gap-2">
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <div class="dropdown">
                        <button class="btn btn-outline-secondary dropdown-toggle rounded-pill fw-semibold px-4 d-inline-flex align-items-center gap-2"
                                type="button"
                                data-bs-toggle="dropdown"
                                aria-expanded="false">
                            @User.FindFirst(ClaimTypes.Email)?.Value
                        </button>

                        <ul class="dropdown-menu dropdown-menu-end shadow-sm">
                            <li>
                                <span class="dropdown-item-text small text-muted">
                                    @User.FindFirst(ClaimTypes.Role)?.Value
                                </span>
                            </li>

                            <li>
                                <hr class="dropdown-divider" />
                            </li>

                            @if (User.IsInRole("Sinh viên"))
                            {
                                <li>
                                    <a class="dropdown-item"
                                       asp-controller="SinhVien"
                                       asp-action="TheoDoiHoSo">
                                        Theo dõi hồ sơ
                                    </a>
                                </li>

                                <li>
                                    <a class="dropdown-item"
                                       asp-controller="SinhVien"
                                       asp-action="TinDaLuu">
                                        Tin đã lưu
                                    </a>
                                </li>

                                <li>
                                    <hr class="dropdown-divider" />
                                </li>
                            }

                            @if (User.IsInRole("Nhà tuyển dụng"))
                            {
                                <li>
                                    <a class="dropdown-item"
                                       asp-controller="NhaTuyenDung"
                                       asp-action="QuanLyTin">
                                        Quản lý tin tuyển dụng
                                    </a>
                                </li>

                                <li>
                                    <hr class="dropdown-divider" />
                                </li>
                            }

                            @if (User.IsInRole("Admin"))
                            {
                                <li>
                                    <a class="dropdown-item"
                                       asp-controller="Admin"
                                       asp-action="QuanLyTin">
                                        Quản lý tin tuyển dụng
                                    </a>
                                </li>

                                <li>
                                    <a class="dropdown-item"
                                       asp-controller="Admin"
                                       asp-action="QuanLyTaiKhoan">
                                        Quản lý tài khoản
                                    </a>
                                </li>

                                <li>
                                    <a class="dropdown-item"
                                       asp-controller="Admin"
                                       asp-action="ThongKe">
                                        Thống kê
                                    </a>
                                </li>

                                <li>
                                    <hr class="dropdown-divider" />
                                </li>
                            }

                            <li>
                                <form asp-controller="TaiKhoan"
                                      asp-action="DangXuat"
                                      method="post">
                                    <button type="submit"
                                            class="dropdown-item text-danger">
                                        Đăng xuất
                                    </button>
                                </form>
                            </li>
                        </ul>
                    </div>
                }
                else
                {
                    <a class="btn btn-outline-secondary rounded-pill fw-semibold px-4 d-inline-flex align-items-center gap-2"
                       asp-controller="TaiKhoan"
                       asp-action="DangNhap">
                        Đăng nhập
                    </a>

                    <a class="btn btn-primary text-white rounded-pill fw-semibold px-4 d-inline-flex align-items-center gap-2"
                       asp-controller="TaiKhoan"
                       asp-action="DangKy">
                        Đăng ký
                    </a>
                }
            </div>
        </div>
    </nav>
</header>